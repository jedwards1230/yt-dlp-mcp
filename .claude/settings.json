{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash(go build *)",
      "Bash(go vet *)",
      "Bash(go test *)",
      "Bash(go mod tidy)",
      "Bash(golangci-lint run *)",
      "Bash(helm lint *)",
      "Bash(helm template *)",
      "Bash(actionlint *)",
      "Bash(pre-commit run *)",
      "Bash(git log *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git branch *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(rg *)",
      "Bash(jq *)",
      "Bash(yq *)"
    ],
    "deny": []
  }
}
